{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "VITE_API_URL",
        "VITE_ASSETS_URL",
        "VITE_TURNSTILE_SITE_KEY",
        "VITE_ENABLE_EMAIL_PASSWORD_AUTH"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck", "build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "deploy:production": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    },
    "deploy:preview": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    }
  }
}
