{
  "name": "@vgskins/api",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir dist",
    "deploy:production": "wrangler deploy --env production",
    "deploy:preview": "wrangler deploy --env preview",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts --config wrangler.toml --include-runtime false --strict-vars false --env-file .dev.vars.example --env-interface ApiEnv",
    "typecheck": "pnpm cf-typegen --check && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@vgskins/db": "workspace:*",
    "@vgskins/logger": "workspace:*",
    "@vgskins/shared": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "fflate": "^0.8.3",
    "hono": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.5",
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "wrangler": "catalog:"
  }
}
