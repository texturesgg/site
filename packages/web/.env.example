# API URL - set this to your deployed API URL for production builds
# Production: https://api.textures.gg
VITE_API_URL=http://localhost:8787
VITE_ASSETS_URL=http://localhost:8787/api/files
# Set exactly when the API has TURNSTILE_SECRET: with the secret and no site
# key, every upload fails "Bot verification required". Leave both unset locally.
VITE_TURNSTILE_SITE_KEY=
# "false" hides email and password sign-in (preview disables it in the API).
VITE_ENABLE_EMAIL_PASSWORD_AUTH=true
