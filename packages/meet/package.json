{
  "name": "@vgskins/meet",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8789",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir dist",
    "deploy:production": "wrangler deploy --env production",
    "deploy:preview": "wrangler deploy --env preview",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts --config wrangler.toml --config ../api/wrangler.toml --include-runtime false --strict-vars false --env-file .dev.vars.example --env-interface MeetEnv",
    "typecheck": "pnpm cf-typegen --check && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vgskins/api": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "wrangler": "catalog:"
  }
}
