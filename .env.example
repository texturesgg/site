# GitHub Actions deployment secrets
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# GitHub Actions build variables
VITE_API_URL=https://api.textures.gg
VITE_ASSETS_URL=https://assets.textures.gg
# Must be set exactly when the API Worker has the TURNSTILE_SECRET secret.
VITE_TURNSTILE_SITE_KEY=your-public-site-key

# For local development, copy the package-specific templates:
#   packages/api/.dev.vars.example -> packages/api/.dev.vars
#   packages/web/.env.example      -> packages/web/.env
