{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "packages/db/migrations/**",
    "packages/*/src/worker-configuration.d.ts",
    "packages/web/src/routeTree.gen.ts"
  ],
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false
}
